{
    "functions": {
        "api/index.js": {
            "includeFiles": "server/**",
            "maxDuration": 300
        }
    },
    "crons": [
        {
            "path": "/api/trends/cron",
            "schedule": "30 0 * * *"
        },
        {
            "path": "/api/trends/report/cron",
            "schedule": "0 13 * * 1"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/login",
            "destination": "/login.html"
        },
        {
            "source": "/signup",
            "destination": "/signup.html"
        },
        {
            "source": "/privacy-policy",
            "destination": "/privacy-policy.html"
        },
        {
            "source": "/data-deletion",
            "destination": "/data-deletion.html"
        }
    ]
}