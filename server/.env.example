ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
FAL_KEY=your_fal_api_key
OPENAI_API_KEY=your_openai_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key
# ─── Own Instagram page (autonomous agent page awareness) ────────
# Set this to YOUR Instagram handle (without @) so the agent understands
# your page, matches your content style, and learns from your post performance.
OWN_INSTAGRAM_HANDLE=your_instagram_handle
# How many of your recent posts to analyze per refresh (default: 50)
# OWN_PAGE_POST_LIMIT=50

WORDPRESS_URL=https://yoursite.com
WORDPRESS_USERNAME=your_username
WORDPRESS_APP_PASSWORD=your_app_password
# ─── Yoast SEO via REST (focus keyphrase / SEO title / meta description) ───
# The publisher sends post slug + excerpt natively, plus Yoast meta keys
# (_yoast_wpseo_focuskw, _yoast_wpseo_title, _yoast_wpseo_metadesc).
# WordPress only persists those meta keys over REST if they are registered.
# Add this ONE-TIME mu-plugin (wp-content/mu-plugins/expose-yoast-rest.php):
#
#   <?php
#   add_action('init', function () {
#     foreach (['_yoast_wpseo_focuskw','_yoast_wpseo_title','_yoast_wpseo_metadesc'] as $key) {
#       register_post_meta('post', $key, [
#         'show_in_rest'  => true,
#         'single'        => true,
#         'type'          => 'string',
#         'auth_callback' => function () { return current_user_can('edit_posts'); },
#       ]);
#     }
#   });
#
# Without it, the slug/excerpt still apply but Yoast title/desc/keyphrase won't stick.
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# ─── Video Generation chain (image stills + Higgsfield DoP video) ───
# The image-first remake chain (Director → Image → QC → Motion → Video).
#
# Image provider: fal.ai (default when FAL_KEY is set) hosts the routed models
# (Nano Banana Pro, Seedream) and exposes /edit slugs for true source-frame
# composition copying. Force a provider with IMAGE_PROVIDER=fal|higgsfield.
# IMAGE_PROVIDER=fal
# fal image model overrides (defaults shown). Each lane has a text-to-image
# (t2i) and an image-to-image (edit, used for use_source_frame) slug:
# FAL_MODEL_NANO=fal-ai/nano-banana-pro
# FAL_MODEL_NANO_EDIT=fal-ai/nano-banana-pro/edit
# FAL_MODEL_SEEDREAM=fal-ai/bytedance/seedream/v4/text-to-image
# FAL_MODEL_SEEDREAM_EDIT=fal-ai/bytedance/seedream/v4/edit
# Source-frame upload (fal /edit) hosts the frame on Vercel Blob:
# BLOB_READ_WRITE_TOKEN=your_vercel_blob_rw_token
#
# Higgsfield is the fallback image provider and still powers video animation.
# Get credentials at https://cloud.higgsfield.ai (key + secret).
HIGGSFIELD_API_KEY=your_higgsfield_api_key
HIGGSFIELD_API_SECRET=your_higgsfield_api_secret
# Optional: combined form instead of the two above — HIGGSFIELD_KEY="key:secret"
# Higgsfield image slug overrides (fallback provider only):
# HF_MODEL_NANO_BANANA=flux-pro/kontext/max/text-to-image
# HF_MODEL_SEEDREAM=flux-pro/kontext/max/text-to-image
# HF_IMAGE_ASPECT=9:16
# HF_IMAGE_REF_PARAM=
# REMAKE_MAX_REGENS=3
# ─── Video (animation) + Assembly stage ───
# Image-to-video provider: fal.ai (default when FAL_KEY is set) runs the
# model the spec named (Kling) plus alternatives; no concurrency cap.
# Force with VIDEO_PROVIDER=fal|higgsfield.
# VIDEO_PROVIDER=fal
# fal image-to-video model. Default = Kling 2.5 Turbo Pro. Swap to Seedance
# (cheaper/faster) by uncommenting the second line:
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
# FAL_VIDEO_MODEL=fal-ai/bytedance/seedance/v1/pro/image-to-video
# FAL_VIDEO_DURATION=5
# Higgsfield fallback (image-to-video DoP). Quality tier:
# dop-turbo (fast, default) | dop-lite | dop-standard (best).
# HF_VIDEO_DOP_MODEL=dop-turbo
# VIDEO_MAX_REGENS=3
# Final cut target length window (seconds); used only when length-matching is
# off (below). Otherwise the remake matches the source video's measured length.
# VIDEO_TARGET_MIN=15
# VIDEO_TARGET_MAX=25
# ─── Length replication ─────────────────────────────────────────
# On by default: the remake reproduces the source's runtime, cut count, and
# per-clip pacing (a 34s source → ~34s remake). Set off to use the fixed
# VIDEO_TARGET_MIN..MAX window instead.
# MATCH_SOURCE_LENGTH=on
# Cap on shots per remake (cost guard); sources with more cuts get merged.
# REMAKE_MAX_SHOTS=10
# A single generated clip's length window (seconds). Kling only offers 5 or 10;
# Seedance supports 2-12, so for precise per-clip lengths prefer Seedance above.
# VIDEO_CLIP_MIN=2
# VIDEO_CLIP_MAX=10
# Slideshow output: seconds each slide is held in the rendered reel (the raw
# slide images are also produced for posting as a native photo carousel).
# SLIDE_SECONDS=2.8
# Platforms the Copy agent writes captions/hashtags for:
# PUBLISH_PLATFORMS=tiktok,instagram,youtube
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Higgsfield file storage hosts the final MP4 (uses your Higgsfield creds).
# ─── Burned captions (word-synced, needs ElevenLabs) ───
# CAPTIONS=on            # set to "off" to disable burned captions
# CAPTION_MAX_WORDS=3    # words per caption pop
# ─── Optional music bed (ducked under the VO) ───
# TREND_MUSIC_URL=https://.../track.mp3   # default bed; per-generation override supported
# MUSIC_GAIN=0.18        # music level under the VO (0-1)
# ─── Cost guardrails + variants ───
# MAX_IMAGE_RENDERS=24   # hard ceiling on image gens per remake (0 = no cap)
# MAX_VIDEO_RENDERS=12   # hard ceiling on clip animations per remake (0 = no cap)
# REMAKE_VARIANTS=1      # remake variants per candidate (1-3); cron renders all

# ─── Trend Engine (Supabase Postgres + EnsembleData) ───
# Supabase: use the pooled connection string (Settings > Database > Connection pooling).
# The Vercel Supabase/Postgres integration also works automatically — it sets
# POSTGRES_URL, which the engine detects without any extra config.
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:6543/postgres

# ─── Ingest provider ────────────────────────────────────────────
# Preferred: Apify — one token covers TikTok, Instagram Reels, and YouTube
# Shorts (multi-platform). When APIFY_TOKEN is set it is used instead of
# EnsembleData. Get a token at https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token
# Which platforms to ingest (comma-separated). Default: all three.
TREND_PLATFORMS=tiktok,instagram,youtube
# Top posts to pull per hashtag per platform (Apify bills per result).
APIFY_RESULTS_PER_HASHTAG=30
# TikTok sort: createTime | playCount | diggCount | shareCount | relevance
APIFY_TIKTOK_SORT=createTime
# Memory (MB, power of 2) per actor run. Lower = more actors fit the account's
# concurrent-memory cap (free plan = 8192MB). 2048 lets ~3 run at once.
APIFY_MEMORY_MB=2048

# ─── Performance-based discovery (search net) ───────────────────
# Discovery mode: both (default) | search (views-only) | hashtag
TREND_DISCOVERY=both
# Hashtag pool to monitor (comma-separated). Defaults to a BROAD set across
# general virality, business, food + industry. Each cycle uses a rotating
# random subset so the feed stays fresh.
# TREND_HASHTAGS=viral,trending,smallbusiness,food,manufacturing
# Search phrases to hunt by, comma-separated. Defaults to a broad set.
# TREND_SEARCH_TERMS=went viral,small business,how its made
# How many hashtags / search terms to use per ingest cycle (rotating subset):
# INGEST_HASHTAG_BATCH=10
# INGEST_SEARCH_BATCH=10
# Rank search results by: mostViews | mostRecent | relevance
APIFY_SEARCH_SORT=mostViews
# Recency window: today | thisWeek | thisMonth | 3months | 6months | allTime
APIFY_SEARCH_DATE=thisMonth
# Results per search term per platform.
APIFY_SEARCH_RESULTS=30
# Only keep videos above this view count (0 = keep all).
APIFY_SEARCH_MIN_VIEWS=0
# Quality gate applied to EVERY net (search AND hashtag). A candidate is kept
# if it has high absolute views (TREND_MIN_VIEWS) OR it's a breakout
# (views >= TREND_BREAKOUT_RATIO x followers, above TREND_BREAKOUT_MIN_VIEWS).
# This drops 1-3k-view junk while surfacing both big hits and small-account
# breakouts. TREND_MIN_ENGAGEMENT drops bought-view bots (low like:view ratio).
TREND_MIN_VIEWS=10000
TREND_BREAKOUT_RATIO=15
TREND_BREAKOUT_MIN_VIEWS=3000
TREND_MIN_ENGAGEMENT=0.0005

# Language/region filter. TikTok search already defaults to US; Instagram and
# YouTube actors return global content with no country option, so we use caption
# language as a proxy for "US audience" content. 'en' (default) keeps English
# and drops clearly non-English (e.g. Brazilian Portuguese) posts. Set to 'any'
# (or empty) to disable and ingest all languages.
TREND_LANG=en

# Deep video analysis (frames + on-screen text + audio transcript + sound).
# Uses Google Gemini's native video understanding. Reuses GEMINI_API_KEY.
# Optional model override (default tries gemini-2.5-flash then 2.0-flash).
# TREND_ANALYZE_MODEL=gemini-2.5-flash

# Fallback provider: EnsembleData (TikTok only). Used only if APIFY_TOKEN unset.
ENSEMBLEDATA_API_KEY=your_ensembledata_api_key

# Scoring + script generation use ANTHROPIC_API_KEY (already set above).
# Video generation reuses FAL_KEY (already set above). Optional overrides:
TREND_VIDEO_MODEL=fal-ai/kling-video/v2/master/text-to-video
TREND_VIDEO_DURATION=5

# Optional: voiceover for generated scripts
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Optional: review-queue notifications (set Telegram pair and/or Slack webhook)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url
